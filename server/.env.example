# Copy this file to .env and fill in values for your setup.

# --- Local Ollama (default) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1:latest

# --- OpenAI (example) ---
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- PostgreSQL (optional) ---
# Leave unset to keep running on in-memory/mock data. Once set, run
# `python init_db.py` once (from server/) to create the tables.
# DATABASE_URL=postgresql://user:password@localhost:5432/project_health_checker

# --- Auth (optional) ---
# Secret used to sign login JWTs (server/auth.py). Leave unset and a random
# secret is generated per process start — fine for local dev, but every
# backend restart invalidates existing sessions. Set a fixed value (any long
# random string) to keep sessions valid across restarts.
# JWT_SECRET=change-me-to-a-long-random-string

# --- Invite emails (optional) ---
# Leave unset and Member Manager invites still work — the invite link is
# just returned in the API response ("copy this link") instead of emailed.
# Set all four SMTP_* to actually send. Example for Gmail: host smtp.gmail.com,
# port 587, an App Password (not your regular password) as SMTP_PASSWORD.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com

# Origin the frontend is served from — used to build the invite link
# (http://<APP_BASE_URL>/#/accept-invite/<token>). Defaults to the Vite dev
# server's default port if unset.
# APP_BASE_URL=http://localhost:5173
